# NestJS Core API base URL for Flutter
# Prefer passing at run time (this file is a reference only):
#   flutter run --dart-define=API_BASE_URL=http://127.0.0.1:3001
#
# Device cheat sheet:
#   iOS Simulator / desktop  → http://127.0.0.1:3001
#   Android emulator         → http://10.0.2.2:3001
#   Physical phone (Wi‑Fi)   → http://<YOUR_LAN_IP>:3001
#     macOS: ipconfig getifaddr en0
#
API_BASE_URL=http://127.0.0.1:3001

# Face Liveness / eGov SSO / eVerify secrets live in backend/.env — not here.
