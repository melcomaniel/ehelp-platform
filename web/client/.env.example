# Nest Core API (required). Must match backend PORT (default 3001).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001

# Optional server-side override for Route Handlers / proxy
# (defaults to NEXT_PUBLIC_API_BASE_URL)
# API_BASE_URL=http://127.0.0.1:3001

# Copy to .env.local:
#   cp .env.example .env.local
#
# Then start Postgres + Nest (see README), then:
#   npm install && npm run dev
# Open http://localhost:3000/signin
#
# Demo staff (after DB seed 002_staff_accounts.sql):
#   evaluator@ehelp.local / Evaluator123!
#   platform@ehelp.local  / PlatformAdmin123!
