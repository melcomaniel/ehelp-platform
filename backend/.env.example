PORT=3001
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=ehelp
DATABASE_PASSWORD=ehelp
DATABASE_NAME=ehelp
JWT_SECRET=ehelp-dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d
AUTH_PROVIDER_MODE=mock
# Per-adapter overrides (optional). Default = AUTH_PROVIDER_MODE.
# Example: mock SSO codes + real Face Liveness camera:
# AUTH_SSO_MODE=mock
# AUTH_EVERIFY_MODE=mock
# AUTH_LIVENESS_MODE=live
# AUTH_PROVIDER_MODE=live  # real camera + PhilSys for all adapters — put secrets in private .env only
# mock = auto-pass adapters for local MVP (no face scan, no National ID check)

EGOV_SSO_BASE_URL=https://hackathon-sso.e.gov.ph
EGOV_PARTNER_CODE=
EGOV_PARTNER_SECRET=
EGOV_SSO_CALLBACK_PATH=/egovph/sso

EVERIFY_BASE_URL=https://hackathon-everify-api.e.gov.ph
EVERIFY_CLIENT_ID=
EVERIFY_CLIENT_SECRET=
EVERIFY_PUBKEY=

# Hackathon Face Liveness Web UI (iframe host for eVerify pubKey)
EVERIFY_LIVENESS_HOST=https://hackathon-everify-face-liveness.e.gov.ph

FACE_LIVENESS_BASE_URL=https://hackathon-face-liveness-api.e.gov.ph
FACE_LIVENESS_API_KEY=
FACE_LIVENESS_MIN_CONFIDENCE=95
CORS_ORIGINS=*
WEB_APP_URL=http://localhost:3000
# Per-machine (optional): set when developing on a physical phone if mock
# liveness still opens 127.0.0.1. Use THIS machine's current LAN IP — update
# whenever Wi‑Fi / DHCP changes. Do not commit a teammate's IP.
# PUBLIC_API_BASE_URL=http://192.168.x.x:3001

# Optional future integrations (leave empty until wired)
# EMESSAGE_ACCESS_TOKEN=
# EMESSAGE_BASE_URL=https://ws-message.e.gov.ph
# --- eGov AI ---
EGOV_AI_BASE_URL=https://egov-ai-core-ws.oueg.info
# EGOV_AI_ACCESS_CODE=
# EGOV_AI_FALLBACK_MOCK=true
# EGOVPAY_API_KEY=
# EGOVPAY_SETTLEMENT_TEMPLATE_UUID=
# EREPORT_ACCESS_TOKEN=
# COMPASS_API_KEY=
